  }.

end SFRMA.

abstract theory EFRMA.

const n_efrma : { int | 0 <= n_efrma } as ge0_nefrma.

op [lossless] dmsg : msg_t distr.

module type Adv_EFRMA = {
    proc forge(pk : pk_t, msigl : (msg_t * sig_t) list) : msg_t * sig_t
