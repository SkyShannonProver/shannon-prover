abstract theory EFCMA.

const q_efcma : { int | 0 <= q_efcma } as ge0_qefcma.

module type Adv_EFCMA(O : SOracle_CMA) = {
    proc forge(pk : pk_t) : msg_t * sig_t
  }.

module EF_CMA(S : Scheme, A : Adv_EFCMA, O : Oracle_CMA) = {

