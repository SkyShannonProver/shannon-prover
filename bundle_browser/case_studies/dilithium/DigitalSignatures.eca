module type Oracle_CMA(S : Scheme) = {
    proc init(sk_init : sk_t) : unit {}
    proc sign(m : msg_t) : sig_t {S.sign}
    proc fresh(m : msg_t) : bool {}
    proc nr_queries() : int {}
  }.

module type SOracle_CMA = {
    proc sign(m : msg_t) : sig_t
  }.

module (O_CMA_Default : Oracle_CMA) (S : Scheme) = {
    var sk : sk_t
    var qs : msg_t list


    proc init(sk_init : sk_t) : unit = {
      sk <- sk_init;
      qs <- [];
    }





    proc sign(m : msg_t) : sig_t = {
      var sig : sig_t;

      sig <@ S.sign(sk, m);

      qs <- rcons qs m;

      return sig;
    }





    proc fresh(m : msg_t) : bool = {
      return ! m \in qs;
    }


    proc nr_queries() : int = {
      return size qs;
    }
  }.

abstract theory TBCMA.

const q_tbcma : { int | 0 <= q_tbcma } as ge0_qtbcma.

module type Adv_TBCMA(O : SOracle_CMA) = {
    proc break(pk : pk_t) : sk_t
  }.

module TB_CMA(S : Scheme, A : Adv_TBCMA, O : Oracle_CMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk, sk' : sk_t;
      var nrqs : int;


      (pk, sk) <@ S.keygen();


      O.init(sk);





      sk' <@ A.break(pk);


      nrqs <@ O.nr_queries();






      return nrqs <= q_tbcma /\ sk' = sk;
    }
  }.

module TB_CMA_U(S : Scheme, A : Adv_TBCMA, O : Oracle_CMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk, sk' : sk_t;


      (pk, sk) <@ S.keygen();


      O.init(sk);





      sk' <@ A.break(pk);


      return sk' = sk;
    }
  }.

end TBCMA.

