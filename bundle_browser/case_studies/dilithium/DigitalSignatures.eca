  }.

module (O_CMA_Default : Oracle_CMA) (S : Scheme) = {
    var sk : sk_t
    var qs : msg_t list


    proc init(sk_init : sk_t) : unit = {
      sk <- sk_init;
      qs <- [];
    }





    proc sign(m : msg_t) : sig_t = {
      var sig : sig_t;

      (sig, sk) <@ S.sign(sk, m);

      qs <- rcons qs m;

      return sig;
    }





    proc fresh(m : msg_t) : bool = {
      return ! m \in qs;
    }


    proc nr_queries() : int = {
      return size qs;
    }
  }.

