    }
  }.

module SF_CMA_U(S : Scheme, A : Adv_SFCMA, O : Oracle_CMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk : sk_t;
      var m : msg_t;
      var sig : sig_t;
      var is_valid, is_fresh : bool;


      m <@ A.pick();


      (pk, sk) <@ S.keygen();


      O.init(sk);





      sig <@ A.forge(pk);





      is_valid <@ S.verify(pk, m, sig);






      is_fresh <@ O.fresh(m);






      return is_valid /\ is_fresh;
    }
  }.

end SFCMA.

abstract theory EFCMA.

const q_efcma : { int | 0 <= q_efcma } as ge0_qefcma.

module type Adv_EFCMA(O : SOracle_CMA) = {
    proc forge(pk : pk_t) : msg_t * sig_t
  }.

module EF_CMA(S : Scheme, A : Adv_EFCMA, O : Oracle_CMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk : sk_t;
      var m : msg_t;
      var sig : sig_t;
      var nrqs : int;
      var is_valid, is_fresh : bool;


      (pk, sk) <@ S.keygen();


      O.init(sk);






      (m, sig) <@ A.forge(pk);





      is_valid <@ S.verify(pk, m, sig);






      is_fresh <@ O.fresh(m);


      nrqs <@ O.nr_queries();







      return nrqs <= q_efcma /\ is_valid /\ is_fresh;
    }
  }.

module EF_CMA_U(S : Scheme, A : Adv_EFCMA, O : Oracle_CMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk : sk_t;
      var m : msg_t;
      var sig : sig_t;
      var is_valid, is_fresh : bool;


      (pk, sk) <@ S.keygen();


      O.init(sk);






      (m, sig) <@ A.forge(pk);





      is_valid <@ S.verify(pk, m, sig);






      is_fresh <@ O.fresh(m);






      return is_valid /\ is_fresh;
    }
  }.

end EFCMA.

abstract theory SEFCMA.

const q_sefcma : { int | 0 <= q_sefcma } as ge0_qsefcma.

module type Oracle_SEFCMA(S : Scheme) = {
    proc init(sk_init : sk_t) : unit {}
    proc sign(m : msg_t) : sig_t {S.sign}
    proc fresh(msig : msg_t * sig_t) : bool {}
    proc nr_queries() : int {}
  }.

module type SOracle_SEFCMA = {
    proc sign(m : msg_t) : sig_t
  }.

module (O_SEFCMA_Default : Oracle_SEFCMA) (S : Scheme) = {
    var sk : sk_t
    var qs : (msg_t * sig_t) list


    proc init(sk_init : sk_t) : unit = {
      sk <- sk_init;
      qs <- [];
    }





    proc sign(m : msg_t) : sig_t = {
      var sig : sig_t;
      var msig : msg_t * sig_t;

      (sig, sk) <@ S.sign(sk, m);

      msig <- (m, sig);
      qs <- rcons qs msig;

      return sig;
    }





    proc fresh(msig : msg_t * sig_t) : bool = {
      return ! msig \in qs;
    }


    proc nr_queries() : int = {
      return size qs;
    }
  }.

module type Adv_SEFCMA(O : SOracle_SEFCMA) = {
    proc forge(pk : pk_t) : msg_t * sig_t
  }.

module SEF_CMA(S : Scheme, A : Adv_SEFCMA, O : Oracle_SEFCMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk : sk_t;
      var m : msg_t;
      var sig : sig_t;
      var nrqs : int;
      var is_valid, is_fresh : bool;


      (pk, sk) <@ S.keygen();


      O.init(sk);






      (m, sig) <@ A.forge(pk);





      is_valid <@ S.verify(pk, m, sig);






      is_fresh <@ O.fresh((m, sig));


      nrqs <@ O.nr_queries();







      return nrqs <= q_sefcma /\ is_valid /\ is_fresh;
    }
  }.

module SEF_CMA_U(S : Scheme, A : Adv_SEFCMA, O : Oracle_SEFCMA) = {

    module O = O(S)


    module A = A(O)

    proc main() : bool = {
      var pk : pk_t;
      var sk : sk_t;
      var m : msg_t;
      var sig : sig_t;
      var is_valid, is_fresh : bool;


      (pk, sk) <@ S.keygen();


      O.init(sk);






      (m, sig) <@ A.forge(pk);





      is_valid <@ S.verify(pk, m, sig);






      is_fresh <@ O.fresh((m, sig));






      return is_valid /\ is_fresh;
    }
  }.

end SEFCMA.

end KeyUpdating.
